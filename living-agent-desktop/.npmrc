# Living Agent Desktop - npm 配置
# 详细参考：DEPENDENCIES.md
#
# 目的：防止 npm 供应链攻击、版本漂移、运行未签名脚本

# ============ 安装行为 ============

# 默认精确版本（不自动升级 ^ 和 ~）
save-exact=true

# 强制使用 package-lock.json（避免 lockfile 漂移）
package-lock=true

# 优先使用本地缓存
prefer-offline=true

# 失败的 fetch 重试次数
fetch-retries=3
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=60000

# ============ 安全策略 ============

# 禁止运行 install 钩子脚本（防止 postinstall 注入）
# 注释：如需启用特定脚本，可在 package.json 中用 "scripts" 字段单独授权
ignore-scripts=true

# 强制 HTTPS（即使配置中写了 git+http://）
# https://blog.npmjs.org/post/163585642605/ssh-key-authentication-and-https

# 强制使用 npm 官方 registry（避免镜像劫持）
registry=https://registry.npmjs.org/

# 强制完整性校验（require 校验所有 tarball 的 SHA512）
# 这是默认开启的

# ============ 输出 ============

# 显示更多审计信息（推荐）
audit-level=moderate

# 日志格式
loglevel=warn


ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/
# ============ 备注 ============

# 启用 ignore-scripts 后：
# - electron-builder 需要手动运行 postinstall（如需 electron-rebuild）
# - 各包的 native 模块编译需手动触发
# 如需临时开启脚本：npm install --ignore-scripts=false <package>
