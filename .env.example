# ===========================================
# Living Agent Service - 环境变量模板
# ===========================================
# 复制此文件为 .env 并填入真实值
#   cp .env.example .env
# ===========================================

# ---------- 数据库 ----------
POSTGRES_PASSWORD=changeme

# ---------- Kafka ----------
KAFKA_ENABLED=true

# ---------- Claude CLI 代理 ----------
CLAUDE_CLI_PROXY_ENABLED=true
CLAUDE_CLI_PROXY_AUTH_TOKEN=
CLAUDE_CLI_PROXY_REQUIRE_AUTH=false

# ---------- RuView WiFi 感知 ----------
RUVIEW_POLLING_ENABLED=false

# ---------- 外部 API Keys ----------
TAVILY_API_KEY=
# NOTION_API_KEY=
# SLACK_BOT_TOKEN=

# ---------- 天气 API ----------
# WEATHER_QWEATHER_KEY=
# WEATHER_OPENWEATHERMAP_KEY=

# ---------- 飞书配置 ----------
FEISHU_ENABLED=true
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# FEISHU_WEBHOOK_KEY=

# ---------- DevOps 工具 ----------
# Jenkins 配置（管理员凭据）
# 说明：JenkinsAdminTool 使用管理员凭据创建 Job/Credential/User
#       员工使用的 JenkinsTool 使用员工专属凭据（在 application.yml 中配置 employee-accounts）
JENKINS_USERNAME=admin
JENKINS_API_TOKEN=your-jenkins-api-token-here

# GitLab 配置（管理员凭据）
# 说明：GitLabAdminTool 使用管理员凭据创建 Group/Project/User/Token
#       员工使用的 GitLabTool 使用员工专属凭据（在 application.yml 中配置 employee-accounts）
GITLAB_ACCESS_TOKEN=your-gitlab-root-token-here

# Jira 配置（备选，OpenProject 优先）
# JIRA_BASE_URL=
# JIRA_EMAIL=
# JIRA_API_TOKEN=

# OpenProject 配置（管理员凭据）
# 说明：OpenProjectAdminTool 使用管理员凭据创建 Project/Role/User/Member
#       员工使用的 OpenProjectTool 使用员工专属凭据（在 application.yml 中配置 employee-accounts）
OPENPROJECT_API_TOKEN=your-openproject-admin-api-key-here

# ---------- Service Admin 配置 ----------
# 说明：管理类工具（GitLabAdminTool/OpenProjectAdminTool/JenkinsAdminTool）
#       通过 ToolRegistry 权限机制区分，MainBrain 可访问，其他大脑不可访问。
#       默认不启用，需要手动设置 SERVICE_ADMIN_ENABLED=true
#       启用后，请配置上述管理员凭据（JENKINS_API_TOKEN、GITLAB_ACCESS_TOKEN、OPENPROJECT_API_TOKEN）
SERVICE_ADMIN_ENABLED=false

# ---------- 工作空间 ----------
WORKSPACE_PATH=../..
