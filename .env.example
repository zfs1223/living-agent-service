# ===========================================
# Living Agent Service - 环境变量模板
# ===========================================
# 复制此文件为 .env 并填入真实值
#   cp .env.example .env
# ===========================================

# ---------- 数据库 ----------
POSTGRES_PASSWORD=changeme

# ---------- Kafka ----------
KAFKA_ENABLED=true

# ---------- Claude CLI 代理 ----------
CLAUDE_CLI_PROXY_ENABLED=true
CLAUDE_CLI_PROXY_AUTH_TOKEN=
CLAUDE_CLI_PROXY_REQUIRE_AUTH=false

# ---------- RuView WiFi 感知 ----------
RUVIEW_POLLING_ENABLED=false

# ---------- 外部 API Keys ----------
TAVILY_API_KEY=
# NOTION_API_KEY=
# SLACK_BOT_TOKEN=

# ---------- 天气 API ----------
# WEATHER_QWEATHER_KEY=
# WEATHER_OPENWEATHERMAP_KEY=

# ---------- 飞书配置 ----------
FEISHU_ENABLED=true
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# FEISHU_WEBHOOK_KEY=

# ---------- DevOps 工具 ----------
# JENKINS_USERNAME=
# JENKINS_API_TOKEN=
# GITLAB_ACCESS_TOKEN=
# JIRA_BASE_URL=
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# OPENPROJECT_API_TOKEN=

# ---------- 工作空间 ----------
WORKSPACE_PATH=../..
